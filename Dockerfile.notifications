FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY prisma ./prisma
RUN ./node_modules/.bin/prisma generate
COPY tsconfig.json ./
COPY src/lib/prisma.ts src/lib/notification-queue.ts src/lib/email-settings.ts src/lib/push-transport.ts ./src/lib/
COPY scripts/notifications-worker.ts ./scripts/
USER node
CMD ["node", "--import", "tsx", "scripts/notifications-worker.ts"]
