# Optional fallback. Owners can save the sender from Configure email in Messages & Alerts.
EMAIL_FROM=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional additional trusted browser origins, comma-separated exact scheme/host/port.
