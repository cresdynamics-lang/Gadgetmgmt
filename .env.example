# App
# Local only. Production Compose clears NEXTAUTH_URL and AUTH_URL so Auth.js
# uses the Cloudflare public host from the request. Do not set these to
# http://localhost:3000 on the server — login redirects would leave the tunnel.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Generate a production secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_TRUST_HOST=true

# Initial owner created by `npm run db:seed`; use a unique password of at least 12 characters.
INITIAL_OWNER_NAME=Administrator
INITIAL_OWNER_EMAIL=aabere70@gmail.com
INITIAL_OWNER_PASSWORD=
# Local testing only. When true, seed also creates branch manager, cashier, and inventory lead
# accounts that share INITIAL_OWNER_PASSWORD. Leave unset in production. When unset, those
# sample accounts are created only if NODE_ENV is not production.
SEED_DEMO_STAFF=

# Postgres (Docker Compose)
DATABASE_URL=postgresql://gadgethub:gadgethub@localhost:5432/gadgethub?schema=public
# In production use your provider's pooled DATABASE_URL and require TLS, for example by adding sslmode=require.
POSTGRES_DB=gadgethub
POSTGRES_USER=gadgethub
POSTGRES_PASSWORD=gadgethub

# Optional catalog opening stock; keep at 0 until verified physical counts are available.
CATALOG_OPENING_STOCK=0

# Optional M-Pesa Daraja integration (test in sandbox first; live callback URL must be public HTTPS)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
# CustomerPayBillOnline for a PayBill; CustomerBuyGoodsOnline for a Till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_SECRET=
# C2B confirmation endpoint; register the public callback with Daraja and use a generated secret.
MPESA_C2B_CALLBACK_SECRET=
# Public site origin for receipts, M-Pesa callbacks, and staff alert links.
# On the server set this to https://your-tunnel-host (not localhost).
APP_BASE_URL=http://localhost:3000

# Optional customer reminders and owner reports (Resend + Africa's Talking)
RESEND_API_KEY=
EMAIL_FROM=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Optional WhatsApp Business Cloud API template reminders. Template needs one body text parameter
# and a URL button whose URL prefix ends with /request/.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PAYMENT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_PAY_BUTTON_INDEX=0
# Generate a unique scheduler secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Optional AI business briefing (server-side only; never expose this key to the browser)
OPENAI_API_KEY=
AI_INSIGHTS_MODEL=gpt-4.1-mini

# Stanbic is the chosen checkout for sales. It is intentionally not called yet.
# The sandbox portal does not publish a callback contract this app can verify.
# Do not mark a sale paid from Stanbic until that callback is confirmed and checked on the server.
# Public sandbox docs list OAuth2 client credentials. Obtain credentials and confirm
# the subscribed API's exact scope, headers, callback contract, and production URLs with Stanbic.
STANBIC_ENVIRONMENT=sandbox
STANBIC_API_BASE_URL=https://sandbox.connect.stanbicbank.co.ke/api/sandbox
STANBIC_OAUTH_TOKEN_URL=https://sandbox.connect.stanbicbank.co.ke/api/sandbox/auth/oauth2/token
STANBIC_CLIENT_ID=
STANBIC_CLIENT_SECRET=
STANBIC_SCOPE=payments
# Configure these only after Stanbic supplies the merchant and callback specifications.
STANBIC_MERCHANT_CODE=
STANBIC_CALLBACK_URL=
STANBIC_CALLBACK_SECRET=
# If issued for your subscribed API product; exact header/name is subject to Stanbic's spec.
STANBIC_SUBSCRIPTION_KEY=

# Authentication: only this configured OWNER identity may sign in as Administrator.
# Falls back to INITIAL_OWNER_EMAIL when unset. Must match the stored account.
AUTH_OWNER_EMAIL=
# APP_BASE_URL must be the canonical HTTPS origin used for email and WebAuthn.
# New-device sign-in requires RESEND_API_KEY and a configured EMAIL_FROM/company sender.
# Fresh installs seed NUH only; existing shops and stock are preserved.
INITIAL_SHOP_ADDRESS=NUH
INITIAL_SHOP_PHONE=

# PWA foreground session lease (seconds, clamped to 60–300). Heartbeats cannot revive an expired lease.
AUTH_FOREGROUND_LEASE_SECONDS=120
