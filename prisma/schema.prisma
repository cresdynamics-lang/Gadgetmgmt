generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  BRANCH_MANAGER
  CASHIER
  INVENTORY_LEAD
}

enum UserStatus {
  ACTIVE
  OFF_SHIFT
  SUSPENDED
}

enum SaleStatus {
  PAID
  PARTIAL
  PENDING
  VOIDED
}

enum CreditStatus {
  ACTIVE
  DUE_SOON
  DUE
  GRACE
  LATE_1
  LATE_2
  LATE_3
  RECOVERY
  OVERDUE
  PAID_OFF
}

enum CreditPlanKind {
  INSTALLMENT
  LAYAWAY
}

enum RescheduleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CreditSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentRequestStatus {
  CREATED
  PROCESSING
  PAID
  REVIEW
  FAILED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum LayawayStatus {
  ACTIVE
  READY_FOR_PICKUP
  FULFILLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  CREDIT_HOLD
}

enum InventoryMovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
}

enum ProductCondition {
  NEW
  EX_UK
}

model Branch {
  id            String                 @id @default(cuid())
  name          String
  code          String                 @unique
  address       String
  phone         String
  email         String?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  users         User[]
  customers     Customer[]
  products      Product[]
  inventory     InventoryItem[]
  sales         Sale[]
  creditPlans   CreditPlan[]
  layawayOrders LayawayOrder[]
  creditPolicy  CreditPolicy?
  movements     InventoryMovement[]
  notifications CustomerNotification[]
}

model User {
  id                        String                    @id @default(cuid())
  name                      String
  email                     String                    @unique
  passwordHash              String
  role                      UserRole                  @default(CASHIER)
  status                    UserStatus                @default(ACTIVE)
  branchId                  String?
  branch                    Branch?                   @relation(fields: [branchId], references: [id])
  sales                     Sale[]
  movements                 InventoryMovement[]
  layawayOrdersCreated      LayawayOrder[]            @relation("LayawayCreatedBy")
  layawayPaymentsReceived   LayawayPayment[]          @relation("LayawayReceivedBy")
  creditSubmissionsReviewed CreditPaymentSubmission[] @relation("CreditSubmissionReviewer")
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
}

model Customer {
  id                       String                     @id @default(cuid())
  name                     String
  phone                    String
  email                    String?
  branchId                 String
  branch                   Branch                     @relation(fields: [branchId], references: [id])
  status                   CustomerStatus             @default(ACTIVE)
  creditLimit              Int                        @default(0)
  reliabilityScore         Int                        @default(100)
  smsRemindersEnabled      Boolean                    @default(false)
  emailRemindersEnabled    Boolean                    @default(false)
  remindersConsentAt       DateTime?
  whatsappRemindersEnabled Boolean                    @default(false)
  whatsappConsentAt        DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  sales                    Sale[]
  creditPlans              CreditPlan[]
  layawayOrders            LayawayOrder[]
  notifications            CustomerNotification[]
  reliabilityEvents        CustomerReliabilityEvent[]

  @@index([branchId, status])
}

model Product {
  id              String              @id @default(cuid())
  sku             String              @unique
  catalogItemId   String?
  productGroup    String?
  configuration   String?
  catalogNotes    String?
  condition       ProductCondition    @default(NEW)
  marketNewPrice  Int?
  marketExUkPrice Int?
  name            String
  category        String
  brand           String?
  costPrice       Int
  sellingPrice    Int
  reorderLevel    Int                 @default(0)
  branchId        String
  branch          Branch              @relation(fields: [branchId], references: [id])
  inventory       InventoryItem[]
  saleItems       SaleItem[]
  creditPlans     CreditPlan[]
  layawayOrders   LayawayOrder[]
  movements       InventoryMovement[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([branchId, category])
}

model InventoryItem {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  stockOnHand   Int      @default(0)
  reservedStock Int      @default(0)
  reorderLevel  Int      @default(0)
  lastUpdatedAt DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([branchId, productId])
}

model Sale {
  id              String                @id @default(cuid())
  invoiceNumber   String                @unique
  branchId        String
  branch          Branch                @relation(fields: [branchId], references: [id])
  cashierId       String
  cashier         User                  @relation(fields: [cashierId], references: [id])
  customerId      String?
  customer        Customer?             @relation(fields: [customerId], references: [id])
  total           Int
  discountAmount  Int                   @default(0)
  taxAmount       Int                   @default(0)
  paidAmount      Int                   @default(0)
  paymentMethod   String                @default("CASH")
  status          SaleStatus            @default(PAID)
  saleItems       SaleItem[]
  payments        SalePayment[]
  creditPlans     CreditPlan[]
  paymentRequests PaymentRequest[]
  layawayOrderId  String?               @unique
  layawayOrder    LayawayOrder?         @relation(fields: [layawayOrderId], references: [id])
  movements       InventoryMovement[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([branchId, createdAt])
}

enum TenderMethod {
  CASH
  MPESA
  CARD
}

model SalePayment {
  id        String       @id @default(cuid())
  saleId    String
  sale      Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount    Int
  method    TenderMethod
  reference String?
  createdAt DateTime     @default(now())

  @@index([saleId, createdAt])
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id])
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Int
  unitPrice      Int
  unitCost       Int      @default(0)
  discountAmount Int      @default(0)
  taxAmount      Int      @default(0)
  total          Int
  createdAt      DateTime @default(now())
}

model CreditPlan {
  id                   String                    @id @default(cuid())
  branchId             String
  branch               Branch                    @relation(fields: [branchId], references: [id])
  customerId           String
  customer             Customer                  @relation(fields: [customerId], references: [id])
  productId            String
  product              Product                   @relation(fields: [productId], references: [id])
  totalAmount          Int
  planReference        String                    @unique @default(cuid())
  kind                 CreditPlanKind            @default(INSTALLMENT)
  saleId               String?
  sale                 Sale?                     @relation(fields: [saleId], references: [id])
  depositAmount        Int                       @default(0)
  balance              Int
  lateFeeAmount        Int                       @default(0)
  lateFeeAppliedAt     DateTime?
  earlySettlementDiscountAmount Int              @default(0)
  imei                 String?                   @unique
  installmentCount     Int
  termMonths           Int                       @default(1)
  nextDueDate          DateTime
  portalTokenHash      String?                   @unique
  status               CreditStatus              @default(ACTIVE)
  payments             Payment[]
  installments         CreditInstallment[]
  rescheduleRequests   CreditRescheduleRequest[]
  paymentSubmissions   CreditPaymentSubmission[]
  paymentRequests      PaymentRequest[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  mpesaC2BTransactions MpesaC2BTransaction[]

  @@index([branchId, status, nextDueDate])
}

model CreditPolicy {
  id                             String   @id @default(cuid())
  branchId                       String   @unique
  branch                         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  graceDays                      Int      @default(3)
  lateFeeAmount                  Int      @default(0)
  minimumDepositPercent          Int      @default(20)
  defaultCreditLimit             Int      @default(0)
  earlySettlementDiscountPercent Int      @default(0)
  managerEscalationDays          Int      @default(3)
  ownerEscalationDays            Int      @default(7)
  updatedAt                      DateTime @updatedAt
  createdAt                      DateTime @default(now())
}

model CreditRescheduleRequest {
  id               String           @id @default(cuid())
  creditPlanId     String
  creditPlan       CreditPlan       @relation(fields: [creditPlanId], references: [id], onDelete: Cascade)
  requestedBy      String
  requestedDueDate DateTime
  reason           String
  status           RescheduleStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
}

model CustomerReliabilityEvent {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  scoreDelta Int
  reason     String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model PaymentRequest {
  id                String               @id @default(cuid())
  creditPlanId      String?
  creditPlan        CreditPlan?          @relation(fields: [creditPlanId], references: [id], onDelete: Cascade)
  saleId            String?
  sale              Sale?                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount            Int
  purpose           String               @default("Credit account payment")
  tokenHash         String               @unique
  dedupeKey         String?              @unique
  payerPhone        String?
  targetPhone       String?
  targetConsentAt   DateTime?
  status            PaymentRequestStatus @default(CREATED)
  checkoutRequestId String?              @unique
  merchantRequestId String?
  mpesaReceipt      String?              @unique
  receivedAmount    Int?
  stkAttempts       Int                  @default(0)
  expiresAt         DateTime
  paidAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, expiresAt])
  @@index([creditPlanId, createdAt])
  @@index([saleId, createdAt])
}

model CustomerNotification {
  id         String              @id @default(cuid())
  branchId   String
  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel    NotificationChannel
  status     NotificationStatus  @default(QUEUED)
  kind       String
  recipient  String
  subject    String?
  body       String
  dedupeKey  String              @unique
  attempts   Int                 @default(0)
  sentAt     DateTime?
  lastError  String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([branchId, createdAt])
}

model CreditInstallment {
  id           String     @id @default(cuid())
  creditPlanId String
  creditPlan   CreditPlan @relation(fields: [creditPlanId], references: [id], onDelete: Cascade)
  sequence     Int
  dueDate      DateTime
  amount       Int
  paidAmount   Int        @default(0)
  paidAt       DateTime?
  createdAt    DateTime   @default(now())

  @@unique([creditPlanId, sequence])
  @@index([dueDate, paidAt])
}

model CreditPaymentSubmission {
  id           String                 @id @default(cuid())
  creditPlanId String
  creditPlan   CreditPlan             @relation(fields: [creditPlanId], references: [id], onDelete: Cascade)
  amount       Int
  reference    String                 @unique
  status       CreditSubmissionStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?                  @relation("CreditSubmissionReviewer", fields: [reviewedById], references: [id])
  createdAt    DateTime               @default(now())

  @@index([status, createdAt])
  @@index([creditPlanId, createdAt])
}

model MpesaC2BTransaction {
  id            String      @id @default(cuid())
  transactionId String      @unique
  billReference String
  phone         String?
  amount        Int
  creditPlanId  String?
  creditPlan    CreditPlan? @relation(fields: [creditPlanId], references: [id], onDelete: SetNull)
  matchedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([billReference, createdAt])
}

model LayawayOrder {
  id          String              @id @default(cuid())
  branchId    String
  branch      Branch              @relation(fields: [branchId], references: [id])
  customerId  String
  customer    Customer            @relation(fields: [customerId], references: [id])
  productId   String
  product     Product             @relation(fields: [productId], references: [id])
  createdById String
  createdBy   User                @relation("LayawayCreatedBy", fields: [createdById], references: [id])
  productName String
  productSku  String
  quantity    Int
  unitPrice   Int
  unitCost    Int
  totalAmount Int
  amountPaid  Int                 @default(0)
  balance     Int
  status      LayawayStatus       @default(ACTIVE)
  payments    LayawayPayment[]
  movements   InventoryMovement[]
  sale        Sale?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  fulfilledAt DateTime?

  @@index([branchId, status, createdAt])
  @@index([customerId, createdAt])
}

model LayawayPayment {
  id             String       @id @default(cuid())
  layawayOrderId String
  layawayOrder   LayawayOrder @relation(fields: [layawayOrderId], references: [id])
  receivedById   String
  receivedBy     User         @relation("LayawayReceivedBy", fields: [receivedById], references: [id])
  amount         Int
  method         TenderMethod
  reference      String?
  createdAt      DateTime     @default(now())

  @@index([layawayOrderId, createdAt])
}

model Payment {
  id           String     @id @default(cuid())
  creditPlanId String
  creditPlan   CreditPlan @relation(fields: [creditPlanId], references: [id])
  amount       Int
  method       String
  reference    String?
  notes        String?
  createdAt    DateTime   @default(now())
}

model InventoryMovement {
  id             String                @id @default(cuid())
  branchId       String
  branch         Branch                @relation(fields: [branchId], references: [id])
  productId      String
  product        Product               @relation(fields: [productId], references: [id])
  userId         String
  user           User                  @relation(fields: [userId], references: [id])
  saleId         String?
  sale           Sale?                 @relation(fields: [saleId], references: [id])
  layawayOrderId String?
  layawayOrder   LayawayOrder?         @relation(fields: [layawayOrderId], references: [id])
  type           InventoryMovementType
  quantity       Int
  reference      String?
  idempotencyKey String?               @unique
  note           String?
  createdAt      DateTime              @default(now())

  @@index([branchId, createdAt])
  @@index([productId, createdAt])
}

model ScheduledJobRun {
  id               String    @id @default(cuid())
  jobName          String
  status           String    @default("RUNNING")
  updatedPlans     Int       @default(0)
  queuedReminders  Int       @default(0)
  queuedDigests    Int       @default(0)
  sentCount        Int       @default(0)
  failedCount      Int       @default(0)
  errorMessage     String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?

  @@index([jobName, startedAt])
}
