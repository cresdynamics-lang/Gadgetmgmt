generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  BRANCH_MANAGER
  CASHIER
  INVENTORY_LEAD
}

enum UserStatus {
  ACTIVE
  OFF_SHIFT
  SUSPENDED
}

enum SaleStatus {
  PAID
  PARTIAL
  PENDING
  VOIDED
}

enum CreditStatus {
  ACTIVE
  DUE_SOON
  DUE
  GRACE
  LATE_1
  LATE_2
  LATE_3
  RECOVERY
  OVERDUE
  PAID_OFF
}

enum CreditPlanKind {
  INSTALLMENT
  LAYAWAY
}

enum RescheduleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CreditSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentRequestStatus {
  CREATED
  PROCESSING
  PAID
  REVIEW
  FAILED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum LayawayStatus {
  ACTIVE
  READY_FOR_PICKUP
  FULFILLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  CREDIT_HOLD
}

enum InventoryMovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
}

enum ProductCondition {
  NEW
  EX_UK
}

enum UnitStatus {
  IN_STOCK
  RESERVED
  SOLD
  IN_REPAIR
  RETURNED
  WITH_PARTNER
  QUARANTINED
}

enum DeviceCondition {
  NEW
  OPEN_BOX
  REFURBISHED
  USED
}

enum NetworkLock {
  UNKNOWN
  LOCKED
  UNLOCKED
}

enum ActivationLock {
  UNKNOWN
  ON
  OFF
}

enum CosmeticGrade {
  A
  B
  C
}

model Branch {
  operations Operation[]
  deviceEvents DeviceEvent[]
  expenses ExpenseEntry[]
  recurringBills RecurringBill[]

  id            String                 @id @default(cuid())
  name          String
  code          String                 @unique
  address       String
  phone         String
  email         String?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  users         User[]
  customers     Customer[]
  products      Product[]
  inventory     InventoryItem[]
  sales         Sale[]
  creditPlans   CreditPlan[]
  layawayOrders LayawayOrder[]
  creditPolicy  CreditPolicy?
  movements     InventoryMovement[]
  notifications CustomerNotification[]
  stockUnits    StockUnit[]
}

model User {
  operations Operation[]
  deviceEvents DeviceEvent[]
  expenses ExpenseEntry[]

  id                        String                    @id @default(cuid())
  name                      String
  email                     String                    @unique
  failedSignIns             Int                       @default(0)
  lockedAt                  DateTime?
  pinAllowed                Boolean                   @default(true)
  passwordAllowed           Boolean                   @default(true)
  ownerApprovedAt           DateTime?
  biometricsAllowed         Boolean                   @default(false)
  accessExpiresAt           DateTime?
  accessPages               String[]                  @default([])
  accessCapabilities        String[]                  @default([])
  authDevices               AuthDevice[]
  authChallenges            AuthChallenge[]
  authEvents                AuthEvent[]
  passwordHash              String
  role                      UserRole                  @default(CASHIER)
  status                    UserStatus                @default(ACTIVE)
  branchId                  String?
  branch                    Branch?                   @relation(fields: [branchId], references: [id])
  createdAlerts             StaffAlert[]              @relation("StaffAlertSender")
  alerts                    StaffAlert[]
  pushSubscriptions         PushSubscription[]
  sales                     Sale[]
  movements                 InventoryMovement[]
  layawayOrdersCreated      LayawayOrder[]            @relation("LayawayCreatedBy")
  layawayPaymentsReceived   LayawayPayment[]          @relation("LayawayReceivedBy")
  creditSubmissionsReviewed CreditPaymentSubmission[] @relation("CreditSubmissionReviewer")
  stockUnits                StockUnit[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
}

model RoleEntitlement {
  role         UserRole @id
  pages        String[]
  capabilities String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  marketingSource String?
  id                       String                     @id @default(cuid())
  name                     String
  phone                    String
  email                    String?
  branchId                 String
  branch                   Branch                     @relation(fields: [branchId], references: [id])
  status                   CustomerStatus             @default(ACTIVE)
  creditLimit              Int                        @default(0)
  reliabilityScore         Int                        @default(100)
  smsRemindersEnabled      Boolean                    @default(false)
  emailRemindersEnabled    Boolean                    @default(false)
  remindersConsentAt       DateTime?
  whatsappRemindersEnabled Boolean                    @default(false)
  whatsappConsentAt        DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  sales                    Sale[]
  creditPlans              CreditPlan[]
  layawayOrders            LayawayOrder[]
  notifications            CustomerNotification[]
  reliabilityEvents        CustomerReliabilityEvent[]

  @@index([branchId, status])
}

model Product {
  referenceDeviceId String?
  referenceDevice DeviceCatalogEntry? @relation(fields: [referenceDeviceId], references: [id], onDelete: SetNull)
  variantTargets VariantTarget[]
  id              String              @id @default(cuid())
  sku             String              @unique
  catalogItemId   String?
  productGroup    String?
  configuration   String?
  catalogNotes    String?
  condition       ProductCondition    @default(NEW)
  marketNewPrice  Int?
  marketExUkPrice Int?
  name            String
  category        String
  brand           String?
  costPrice       Int
  sellingPrice    Int
  reorderLevel    Int                 @default(0)
  unitTracking    Boolean?
  branchId        String
  branch          Branch              @relation(fields: [branchId], references: [id])
  inventory       InventoryItem[]
  saleItems       SaleItem[]
  creditPlans     CreditPlan[]
  layawayOrders   LayawayOrder[]
  movements       InventoryMovement[]
  stockUnits      StockUnit[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([branchId, category])
}

// Public reference information is independent of shop stock, cost and physical serials.
model DeviceCatalogSource {
  id String @id
  name String
  license String
  licenseUrl String
  enabled Boolean @default(false)
  refreshSeconds Int @default(86400)
  cursor String?
  nextRunAt DateTime @default(now())
  cooldownUntil DateTime?
  leaseToken String?
  leaseUntil DateTime?
  etag String?
  lastModified String?
  lastCheckedAt DateTime?
  lastSuccessAt DateTime?
  lastHttpStatus Int?
  status String @default("DISABLED")
  lastError String?
  failureCount Int @default(0)
  discoveredCount Int @default(0)
  changedCount Int @default(0)
  rejectedCount Int @default(0)
  entries DeviceCatalogEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([enabled, nextRunAt])
}

model DeviceCatalogHost {
  origin String @id
  nextAllowedAt DateTime @default(now())
  windowStartedAt DateTime @default(now())
  requestCount Int @default(0)
}

model DeviceCatalogEntry {
  id String @id @default(cuid())
  sourceId String
  source DeviceCatalogSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalId String
  name String
  brand String
  manufacturer String?
  category String
  family String?
  granularity String @default("MODEL")
  description String?
  modelNumbers String[] @default([])
  partNumbers String[] @default([])
  gtins String[] @default([])
  colors String[] @default([])
  storage String[] @default([])
  memory String[] @default([])
  regions String[] @default([])
  compatibility String[] @default([])
  released String?
  discontinued String?
  specifications Json
  sourceUrl String
  contentHash String
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  changedAt DateTime @default(now())
  identifiers DeviceCatalogIdentifier[]
  observations DeviceCatalogObservation[]
  products Product[]
  @@unique([sourceId, externalId])
  @@index([brand, name])
  @@index([changedAt])
}

model DeviceCatalogIdentifier {
  id String @id @default(cuid())
  entryId String
  entry DeviceCatalogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kind String
  value String
  normalizedValue String
  active Boolean @default(true)
  @@unique([entryId, kind, normalizedValue])
  @@index([normalizedValue])
}

model DeviceCatalogObservation {
  id String @id @default(cuid())
  entryId String
  entry DeviceCatalogEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  contentHash String
  snapshot Json
  observedAt DateTime @default(now())
  @@index([entryId, contentHash])
  @@index([entryId, observedAt])
}

model InventoryItem {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  stockOnHand   Int      @default(0)
  reservedStock Int      @default(0)
  reorderLevel  Int      @default(0)
  lastUpdatedAt DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([branchId, productId])
}

model Sale {
  operations Operation[]

  id              String                @id @default(cuid())
  invoiceNumber   String                @unique
  branchId        String
  branch          Branch                @relation(fields: [branchId], references: [id])
  cashierId       String
  cashier         User                  @relation(fields: [cashierId], references: [id])
  customerId      String?
  customer        Customer?             @relation(fields: [customerId], references: [id])
  total           Int
  discountAmount  Int                   @default(0)
  taxAmount       Int                   @default(0)
  paidAmount      Int                   @default(0)
  paymentMethod   String                @default("CASH")
  status          SaleStatus            @default(PAID)
  saleItems       SaleItem[]
  payments        SalePayment[]
  creditPlans     CreditPlan[]
  paymentRequests PaymentRequest[]
  layawayOrderId  String?               @unique
  layawayOrder    LayawayOrder?         @relation(fields: [layawayOrderId], references: [id])
  movements       InventoryMovement[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([branchId, createdAt])
}

enum TenderMethod {
  CASH
  MPESA
  CARD
}

model SalePayment {
  id        String       @id @default(cuid())
  saleId    String
  sale      Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount    Int
  method    TenderMethod
  reference String?
  createdAt DateTime     @default(now())

  @@index([saleId, createdAt])
}

model SaleItem {
  totalCost Int?
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id])
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Int
  unitPrice      Int
  unitCost       Int      @default(0)
  discountAmount Int      @default(0)
  taxAmount      Int      @default(0)
  total          Int
  stockUnits     StockUnit[]
  createdAt      DateTime @default(now())
}

model StockUnit {
  ownership String @default("SHOP")
  ownerName String?
  operations Operation[]
  events DeviceEvent[]

  id                 String           @id @default(cuid())
  branchId           String
  branch             Branch           @relation(fields: [branchId], references: [id])
  productId          String
  product            Product          @relation(fields: [productId], references: [id])
  recordedById       String
  recordedBy         User             @relation(fields: [recordedById], references: [id])
  imei               String?          @unique
  imei2              String?          @unique
  serialNumber       String?          @unique
  barcode            String?
  status             UnitStatus       @default(IN_STOCK)
  condition          DeviceCondition  @default(NEW)
  cosmeticGrade      CosmeticGrade?
  color              String?
  storage            String?
  ram                String?
  screenSize         String?
  processor          String?
  region             String?
  camera             String?
  networkLock        NetworkLock      @default(UNKNOWN)
  osVersion          String?
  activationLock     ActivationLock   @default(UNKNOWN)
  batteryHealth      Int?
  location           String?
  supplierName       String?
  purchaseReference  String?
  notes              String?
  saleItemId         String?
  saleItem           SaleItem?        @relation(fields: [saleItemId], references: [id])
  receivedAt         DateTime         @default(now())
  soldAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([branchId, status])
  @@index([productId, status])
  @@index([saleItemId])
}

model CreditPlan {
  id                   String                    @id @default(cuid())
  branchId             String
  branch               Branch                    @relation(fields: [branchId], references: [id])
  customerId           String
  customer             Customer                  @relation(fields: [customerId], references: [id])
  productId            String
  product              Product                   @relation(fields: [productId], references: [id])
  totalAmount          Int
  planReference        String                    @unique @default(cuid())
  kind                 CreditPlanKind            @default(INSTALLMENT)
  saleId               String?
  sale                 Sale?                     @relation(fields: [saleId], references: [id])
  depositAmount        Int                       @default(0)
  balance              Int
  lateFeeAmount        Int                       @default(0)
  lateFeeAppliedAt     DateTime?
  earlySettlementDiscountAmount Int              @default(0)
  imei                 String?                   @unique
  installmentCount     Int
  termMonths           Int                       @default(1)
  nextDueDate          DateTime
  portalTokenHash      String?                   @unique
  status               CreditStatus              @default(ACTIVE)
  payments             Payment[]
  installments         CreditInstallment[]
  rescheduleRequests   CreditRescheduleRequest[]
  paymentSubmissions   CreditPaymentSubmission[]
  paymentRequests      PaymentRequest[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  mpesaC2BTransactions MpesaC2BTransaction[]

  @@index([branchId, status, nextDueDate])
}

model CreditPolicy {
  id                             String   @id @default(cuid())
  branchId                       String   @unique
  branch                         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  graceDays                      Int      @default(3)
  lateFeeAmount                  Int      @default(0)
  minimumDepositPercent          Int      @default(20)
  defaultCreditLimit             Int      @default(0)
  earlySettlementDiscountPercent Int      @default(0)
  managerEscalationDays          Int      @default(3)
  ownerEscalationDays            Int      @default(7)
  updatedAt                      DateTime @updatedAt
  createdAt                      DateTime @default(now())
}

model CreditRescheduleRequest {
  id               String           @id @default(cuid())
  creditPlanId     String
  creditPlan       CreditPlan       @relation(fields: [creditPlanId], references: [id], onDelete: Cascade)
  requestedBy      String
  requestedDueDate DateTime
  reason           String
  status           RescheduleStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
}

model CustomerReliabilityEvent {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  scoreDelta Int
  reason     String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model PaymentRequest {
  id                String               @id @default(cuid())
  creditPlanId      String?
  creditPlan        CreditPlan?          @relation(fields: [creditPlanId], references: [id], onDelete: Cascade)
  saleId            String?
  sale              Sale?                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount            Int
  purpose           String               @default("Credit account payment")
  tokenHash         String               @unique
  dedupeKey         String?              @unique
  payerPhone        String?
  targetPhone       String?
  targetConsentAt   DateTime?
  status            PaymentRequestStatus @default(CREATED)
  checkoutRequestId String?              @unique
  merchantRequestId String?
  mpesaReceipt      String?              @unique
  receivedAmount    Int?
  stkAttempts       Int                  @default(0)
  expiresAt         DateTime
  paidAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, expiresAt])
  @@index([creditPlanId, createdAt])
  @@index([saleId, createdAt])
}

model CustomerNotification {
  id         String              @id @default(cuid())
  branchId   String
  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel    NotificationChannel
  status     NotificationStatus  @default(QUEUED)
  kind       String
  recipient  String
  subject    String?
  body       String
  dedupeKey  String              @unique
  attempts   Int                 @default(0)
  sentAt     DateTime?
  lastError  String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([branchId, createdAt])
}

model CreditInstallment {
  id           String     @id @default(cuid())
  creditPlanId String
  creditPlan   CreditPlan @relation(fields: [creditPlanId], references: [id], onDelete: Cascade)
  sequence     Int
  dueDate      DateTime
  amount       Int
  paidAmount   Int        @default(0)
  paidAt       DateTime?
  createdAt    DateTime   @default(now())

  @@unique([creditPlanId, sequence])
  @@index([dueDate, paidAt])
}

model CreditPaymentSubmission {
  id           String                 @id @default(cuid())
  creditPlanId String
  creditPlan   CreditPlan             @relation(fields: [creditPlanId], references: [id], onDelete: Cascade)
  amount       Int
  reference    String                 @unique
  status       CreditSubmissionStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?                  @relation("CreditSubmissionReviewer", fields: [reviewedById], references: [id])
  createdAt    DateTime               @default(now())

  @@index([status, createdAt])
  @@index([creditPlanId, createdAt])
}

model MpesaC2BTransaction {
  id            String      @id @default(cuid())
  transactionId String      @unique
  billReference String
  phone         String?
  amount        Int
  creditPlanId  String?
  creditPlan    CreditPlan? @relation(fields: [creditPlanId], references: [id], onDelete: SetNull)
  matchedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([billReference, createdAt])
}

model LayawayOrder {
  id          String              @id @default(cuid())
  branchId    String
  branch      Branch              @relation(fields: [branchId], references: [id])
  customerId  String
  customer    Customer            @relation(fields: [customerId], references: [id])
  productId   String
  product     Product             @relation(fields: [productId], references: [id])
  createdById String
  createdBy   User                @relation("LayawayCreatedBy", fields: [createdById], references: [id])
  productName String
  productSku  String
  quantity    Int
  unitPrice   Int
  unitCost    Int
  totalAmount Int
  amountPaid  Int                 @default(0)
  balance     Int
  status      LayawayStatus       @default(ACTIVE)
  payments    LayawayPayment[]
  movements   InventoryMovement[]
  sale        Sale?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  fulfilledAt DateTime?

  @@index([branchId, status, createdAt])
  @@index([customerId, createdAt])
}

model LayawayPayment {
  id             String       @id @default(cuid())
  layawayOrderId String
  layawayOrder   LayawayOrder @relation(fields: [layawayOrderId], references: [id])
  receivedById   String
  receivedBy     User         @relation("LayawayReceivedBy", fields: [receivedById], references: [id])
  amount         Int
  method         TenderMethod
  reference      String?
  createdAt      DateTime     @default(now())

  @@index([layawayOrderId, createdAt])
}

model Payment {
  id           String     @id @default(cuid())
  creditPlanId String
  creditPlan   CreditPlan @relation(fields: [creditPlanId], references: [id])
  amount       Int
  method       String
  reference    String?
  notes        String?
  createdAt    DateTime   @default(now())
}

model InventoryMovement {
  id             String                @id @default(cuid())
  branchId       String
  branch         Branch                @relation(fields: [branchId], references: [id])
  productId      String
  product        Product               @relation(fields: [productId], references: [id])
  userId         String
  user           User                  @relation(fields: [userId], references: [id])
  saleId         String?
  sale           Sale?                 @relation(fields: [saleId], references: [id])
  layawayOrderId String?
  layawayOrder   LayawayOrder?         @relation(fields: [layawayOrderId], references: [id])
  type           InventoryMovementType
  quantity       Int
  reference      String?
  idempotencyKey String?               @unique
  note           String?
  createdAt      DateTime              @default(now())

  @@index([branchId, createdAt])
  @@index([productId, createdAt])
}

model ScheduledJobRun {
  id               String    @id @default(cuid())
  jobName          String
  status           String    @default("RUNNING")
  updatedPlans     Int       @default(0)
  queuedReminders  Int       @default(0)
  queuedDigests    Int       @default(0)
  sentCount        Int       @default(0)
  failedCount      Int       @default(0)
  errorMessage     String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?

  @@index([jobName, startedAt])
}


// Staff inbox is independent of customer reminder delivery and consent.
model StaffAlert {
  senderId    String?
  sender      User?    @relation("StaffAlertSender", fields: [senderId], references: [id], onDelete: SetNull)
  requestKey  String?  @unique
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  scheduledAt DateTime @default(now())
  readAt      DateTime?
  createdAt   DateTime @default(now())
  deliveries  StaffAlertDelivery[]

  @@index([senderId, createdAt])
  @@index([userId, scheduledAt, readAt])
}

model StaffAlertDelivery {
  id        String @id @default(cuid())
  alertId   String
  alert     StaffAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel   String
  status    NotificationStatus @default(QUEUED)
  attempts  Int @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([alertId, channel])
  @@index([status, createdAt])
}

model PushSubscription {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model NotificationEmailSettings {
  id          String   @id @default("company")
  senderEmail String
  senderName  String   @default("GadgetHub")
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model NotificationRateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}


model AuthDevice {
  pinAllowed Boolean @default(true)
  passwordAllowed Boolean @default(true)
  biometricsAllowed Boolean @default(true)
  pinHash String?
  pinVersion Int @default(0)
  pinUpdatedAt DateTime?
  activeUntil DateTime?
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  label String
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  revokedAt DateTime?
  lockedAt DateTime?
  passkeys AuthPasskey[]
  @@index([userId, revokedAt])
}

model AuthPasskey {
  id String @id
  deviceId String
  device AuthDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  publicKey Bytes
  counter BigInt @default(0)
  transports String[]
  createdAt DateTime @default(now())
}

model AuthChallenge {
  authMethod String @default("PASSWORD")
  credentialVersion Int?
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  value String
  deviceId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, kind, createdAt])
}

model AuthEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  action String
  deviceLabel String
  createdAt DateTime @default(now())
  @@index([createdAt])
}


enum OperationKind {
  REPAIR
  DELIVERY
  PARTNER
  TRADE_IN
  RETURN
}

model Operation {
  partnerDirection String @default("OUT")
  requestHash String
  id String @id @default(cuid())
  requestKey String @unique
  kind OperationKind
  status String
  version Int @default(0)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  unitId String
  unit StockUnit @relation(fields: [unitId], references: [id])
  saleId String?
  sale Sale? @relation(fields: [saleId], references: [id])
  party String
  contact String?
  destination String?
  reference String?
  details String
  dueAt DateTime
  codAmount Int @default(0)
  paidAmount Int @default(0)
  costAmount Int?
  proof String?
  inspection Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt DateTime?
  @@index([branchId, kind, status, dueAt])
  @@index([unitId, closedAt])
}

model DeviceEvent {
  requestKey String? @unique
  requestHash String?
  id String @id @default(cuid())
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  unitId String
  unit StockUnit @relation(fields: [unitId], references: [id])
  userId String?
  user User? @relation(fields: [userId], references: [id])
  kind String
  note String
  saleId String?
  operationId String?
  amount Int?
  createdAt DateTime @default(now())
  @@index([unitId, createdAt])
}

model ExpenseEntry {
  requestHash String
  id String @id @default(cuid())
  requestKey String @unique
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  category String
  payee String
  description String
  amount Int
  occurredAt DateTime
  reference String
  unitId String?
  operationId String?
  reversesId String? @unique
  billId String?
  period String?
  createdAt DateTime @default(now())
  @@index([branchId, occurredAt])
  @@unique([billId, period])
}

model RecurringBill {
  requestHash String
  id String @id @default(cuid())
  requestKey String @unique
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  title String
  payee String
  category String
  amount Int
  dueDay Int
  active Boolean @default(true)
  createdAt DateTime @default(now())
}


model VariantTarget {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  color String
  storage String
  targetAvailable Int
  updatedAt DateTime @updatedAt
  @@unique([productId,color,storage])
}
