generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  BRANCH_MANAGER
  CASHIER
  INVENTORY_LEAD
}

enum UserStatus {
  ACTIVE
  OFF_SHIFT
  SUSPENDED
}

enum SaleStatus {
  PAID
  PARTIAL
  PENDING
  VOIDED
}

enum CreditStatus {
  ACTIVE
  DUE_SOON
  OVERDUE
  PAID_OFF
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  CREDIT_HOLD
}

enum InventoryMovementType {
  RECEIPT
  SALE
  ADJUSTMENT
}

enum ProductCondition {
  NEW
  EX_UK
}

model Branch {
  id          String         @id @default(cuid())
  name        String
  code        String         @unique
  address     String
  phone       String
  email       String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  users       User[]
  customers   Customer[]
  products    Product[]
  inventory   InventoryItem[]
  sales       Sale[]
  creditPlans CreditPlan[]
  movements   InventoryMovement[]
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(CASHIER)
  status       UserStatus  @default(ACTIVE)
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id])
  sales        Sale[]
  movements    InventoryMovement[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Customer {
  id          String      @id @default(cuid())
  name        String
  phone       String
  email       String?
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id])
  status      CustomerStatus @default(ACTIVE)
  creditLimit Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  sales       Sale[]
  creditPlans CreditPlan[]

  @@index([branchId, status])
}

model Product {
  id                String           @id @default(cuid())
  sku               String           @unique
  catalogItemId     String?
  productGroup      String?
  configuration     String?
  catalogNotes      String?
  condition         ProductCondition @default(NEW)
  marketNewPrice    Int?
  marketExUkPrice   Int?
  name              String
  category          String
  brand             String?
  costPrice         Int
  sellingPrice      Int
  reorderLevel      Int              @default(0)
  branchId          String
  branch            Branch           @relation(fields: [branchId], references: [id])
  inventory         InventoryItem[]
  saleItems         SaleItem[]
  creditPlans       CreditPlan[]
  movements         InventoryMovement[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([branchId, category])
}

model InventoryItem {
  id             String   @id @default(cuid())
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id])
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  stockOnHand   Int      @default(0)
  reservedStock  Int      @default(0)
  reorderLevel  Int      @default(0)
  lastUpdatedAt DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([branchId, productId])
}

model Sale {
  id            String      @id @default(cuid())
  invoiceNumber  String      @unique
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id])
  cashierId     String
  cashier       User        @relation(fields: [cashierId], references: [id])
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  total         Int
  discountAmount Int        @default(0)
  taxAmount     Int         @default(0)
  paidAmount    Int         @default(0)
  paymentMethod String      @default("CASH")
  status        SaleStatus  @default(PAID)
  saleItems     SaleItem[]
  creditPlans   CreditPlan[]
  movements     InventoryMovement[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([branchId, createdAt])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int
  unitCost  Int      @default(0)
  discountAmount Int @default(0)
  taxAmount Int       @default(0)
  total     Int
  createdAt DateTime @default(now())
}

model CreditPlan {
  id              String      @id @default(cuid())
  branchId        String
  branch          Branch      @relation(fields: [branchId], references: [id])
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  totalAmount     Int
  saleId          String?
  sale            Sale?       @relation(fields: [saleId], references: [id])
  depositAmount   Int         @default(0)
  balance         Int
  installmentCount Int
  nextDueDate     DateTime
  status          CreditStatus @default(ACTIVE)
  payments        Payment[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([branchId, status, nextDueDate])
}

model Payment {
  id            String      @id @default(cuid())
  creditPlanId  String
  creditPlan    CreditPlan  @relation(fields: [creditPlanId], references: [id])
  amount        Int
  method        String
  reference     String?
  notes         String?
  createdAt     DateTime    @default(now())
}

model InventoryMovement {
  id        String               @id @default(cuid())
  branchId  String
  branch    Branch               @relation(fields: [branchId], references: [id])
  productId String
  product   Product              @relation(fields: [productId], references: [id])
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  saleId    String?
  sale      Sale?                @relation(fields: [saleId], references: [id])
  type      InventoryMovementType
  quantity  Int
  reference String?
  note      String?
  createdAt DateTime             @default(now())

  @@index([branchId, createdAt])
  @@index([productId, createdAt])
}

