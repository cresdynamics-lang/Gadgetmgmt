FROM node:22.23.5-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --chown=node:node package.json package-lock.json next.config.ts tsconfig.json ./
COPY --chown=node:node public ./public
COPY --chown=node:node prisma ./prisma
COPY --chown=node:node worker ./worker
COPY --chown=node:node .next ./.next
COPY --chown=node:node node_modules ./node_modules

ENV NODE_ENV=production
EXPOSE 3005

USER node

# Listen on every container interface so the tunnel container can reach this service.
CMD ["node", "./node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3005"]
